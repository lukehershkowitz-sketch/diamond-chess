# Copy to .env.local for local development; on Vercel set these under Settings -> Environment Variables.

# Required for the AI Coach (/coach, "Explain with Coach", puzzle explanations).
# Without it the rest of the site works and the coach says it isn't switched on.
# ANTHROPIC_API_KEY=

# Optional: override the coach's model (default claude-opus-5-5).
# COACH_MODEL=

# Future: accounts and saved reviews.
# DATABASE_URL=postgres://user:pass@host/db
# AUTH_SECRET=
